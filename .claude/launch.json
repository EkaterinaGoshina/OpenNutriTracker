{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-build",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "build/web"
      ],
      "port": 8090
    },
    {
      "name": "worker-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "run",
        "dev",
        "--",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}